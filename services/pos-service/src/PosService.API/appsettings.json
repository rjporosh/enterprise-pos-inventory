{
  "ServiceName": "pos-service",
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    }
  },
  "Database": {
    "Provider": "PostgreSQL",
    "ConnectionString": "Host=localhost;Port=5432;Database=pos_db;Username=postgres;Password=postgres"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "pos-service:"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:4200"]
  },
  "ApiAuth": {
    "Enabled": false,
    "ApiKey": ""
  },
  "RateLimiting": {
    "Enabled": false,
    "Api": {
      "PermitLimit": 100,
      "WindowSeconds": 60
    },
    "Write": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "Health": {
      "PermitLimit": 300,
      "WindowSeconds": 60
    },
    "Global": {
      "PermitLimit": 500,
      "WindowSeconds": 60
    }
  }
}
