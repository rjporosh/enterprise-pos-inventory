{
  "ServiceName": "gateway",
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000", "http://localhost:3001"]
  },
  "RateLimiting": {
    "PermitLimit": 200,
    "WindowSeconds": 60
  },
  "Seq": {
    "Url": "http://localhost:5341"
  },
  "Observability": {
    "OtlpEndpoint": ""
  },
  "Services": {
    "auth-service": { "HealthUrl": "http://localhost:5100/health" },
    "notification-service": { "HealthUrl": "http://localhost:5300/health" },
    "inventory-service": { "HealthUrl": "http://localhost:5002/health" },
    "pos-service": { "HealthUrl": "http://localhost:5001/health" }
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/v1/auth/{**catch-all}" }
      },
      "auth-admin-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/v1/admin/{**catch-all}" }
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/v1/notifications/{**catch-all}" }
      },
      "notification-recipients-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/v1/recipients/{**catch-all}" }
      },
      "notification-templates-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/v1/templates/{**catch-all}" }
      },
      "inventory-products-route": {
        "ClusterId": "inventory-cluster",
        "Match": { "Path": "/api/v1/products/{**catch-all}" }
      },
      "inventory-stocks-route": {
        "ClusterId": "inventory-cluster",
        "Match": { "Path": "/api/v1/stocks/{**catch-all}" }
      },
      "pos-sales-route": {
        "ClusterId": "pos-cluster",
        "Match": { "Path": "/api/v1/sales/{**catch-all}" }
      },
      "pos-cash-sessions-route": {
        "ClusterId": "pos-cluster",
        "Match": { "Path": "/api/v1/cash-sessions/{**catch-all}" }
      },
      "pos-reports-route": {
        "ClusterId": "pos-cluster",
        "Match": { "Path": "/api/v1/reports/{**catch-all}" }
      },
      "pos-stores-route": {
        "ClusterId": "pos-cluster",
        "Match": { "Path": "/api/v1/stores/{**catch-all}" }
      },
      "pos-registers-route": {
        "ClusterId": "pos-cluster",
        "Match": { "Path": "/api/v1/registers/{**catch-all}" }
      },
      "pos-cashiers-route": {
        "ClusterId": "pos-cluster",
        "Match": { "Path": "/api/v1/cashiers/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5100/" }
        },
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:15", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health" }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5300/" }
        },
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:15", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health" }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5002/" }
        },
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:15", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health" }
        }
      },
      "pos-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5001/" }
        },
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:15", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health" }
        }
      }
    }
  }
}
