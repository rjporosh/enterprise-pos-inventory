# Copy to .env.local and point at your running inventory-service — or, once
# services/gateway is running (see its README), at the gateway on :5010, since
# every inventory-service route this app calls (/api/v1/products, /api/v1/stocks)
# is proxied through unchanged. Point at inventory-service directly (:5002) only
# if you're deliberately bypassing the gateway (e.g. developing without Docker).
# No default is baked into the app — an unset value fails fast with a clear
# config error instead of silently sending requests to the wrong place.
NEXT_PUBLIC_INVENTORY_API_URL=http://localhost:5010
# auth-service, also proxied through the gateway.
NEXT_PUBLIC_AUTH_API_URL=http://localhost:5010
