# Copy to .env.local and point at your running pos-service/inventory-service —
# or, once services/gateway is running (see its README), at the gateway on
# :5010 for both, since every route this app calls (/api/v1/sales,
# /api/v1/cash-sessions, /api/v1/reports, /api/v1/products) is proxied through
# unchanged. Point at each service directly (:5001/:5002) only if you're
# deliberately bypassing the gateway (e.g. developing without Docker).
# No default is baked into the app — an unset value fails fast with a clear
# config error instead of silently sending requests to the wrong place.
NEXT_PUBLIC_POS_API_URL=http://localhost:5010
NEXT_PUBLIC_INVENTORY_API_URL=http://localhost:5010
